# 示例配置：复制为 .env 或直接 export 到当前 shell。
# 程序不解析 .env 文件，只读取环境变量；仓库中不保存任何真实口令，请自行填写。

# ---- 方式一：整条连接串（副本集 / 分片集群 mongos 场景最方便）----
LIB_DB_URI=mongodb://<user>:<password>@127.0.0.1:27017/library?authSource=library

# ---- 方式二：分开给参数（由 config.py 拼成 URI）----
# LIB_DB_HOST=127.0.0.1
# LIB_DB_PORT=27017
# LIB_DB_USER=<user>
# LIB_DB_PASSWORD=<password>
# LIB_DB_AUTH_DB=library
# LIB_DB_NAME=library
# LIB_DB_REPLICA_SET=rs0          # 仅副本集场景填写，单机/分片留空
# LIB_DB_READ_PREF=secondaryPreferred

# ---- 建账号脚本读取的口令（scripts/init_db.py）----
# LIB_PWD_READONLY=<password>
# LIB_PWD_READWRITE=<password>
# LIB_PWD_ADMIN=<password>
# LIB_PWD_CLUSTER=<password>

# ---- 本地目录 ----
# LIB_DATA_DIR=./data
# LIB_EXPORT_DIR=./exports
